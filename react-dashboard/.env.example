# Base URL for the Go backend API.
# Leave as /api/v1 in local development to use Vite's built-in proxy to http://localhost:8080,
# or set to https://your-go-service.example.com/api/v1 in production.
VITE_API_BASE_URL=/api/v1

# Optional Bearer token if DASHBOARD_API_KEY is configured on the Go server
VITE_DASHBOARD_API_KEY=
