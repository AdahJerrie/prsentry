# Runtime mode: development | production
ENVIRONMENT=development
PORT=8080

# PostgreSQL credentials (used by docker-compose.yml & Go service)
POSTGRES_USER=prsentry
POSTGRES_PASSWORD=replace_with_local_postgres_password
POSTGRES_DB=prsentry_dev
DATABASE_URL=postgres://prsentry:replace_with_local_postgres_password@localhost:5432/prsentry_dev?sslmode=disable

# GitHub App credentials (Go service — provide either file path or inline PEM)
GITHUB_WEBHOOK_SECRET=replace_with_webhook_hmac_secret
GITHUB_APP_ID=replace_with_github_app_id
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/github-app-private-key.pem
GITHUB_APP_PRIVATE_KEY=

# Service-to-service authentication (shared by Go & Python services)
PYTHON_SERVICE_URL=http://localhost:8000
INTERNAL_AUTH_TOKEN=replace_with_32_byte_internal_shared_token

# Dashboard CORS & optional API protection (Go service)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
DASHBOARD_API_KEY=

# LLM provider credentials (Python service)
ANTHROPIC_API_KEY=replace_with_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
